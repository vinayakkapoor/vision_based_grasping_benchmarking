<?xml version="1.0"?>
<package format="3">
  <name>ros_deep_grasp</name>
  <version>0.0.0</version>
  <description>The ros_deep_grasp package</description>

  <!-- One maintainer tag required, multiple allowed, one person per tag -->
  <!-- Example:  -->
  <!-- <maintainer email="jane.doe@example.com">Jane Doe</maintainer> -->
  <maintainer email="rbhalekar@wpi.edu">rhea</maintainer>


  <!-- One license tag required, multiple allowed, one license per tag -->
  <!-- Commonly used license strings: -->
  <!--   BSD, MIT, Boost Software License, GPLv2, GPLv3, LGPLv2.1, LGPLv3 -->
  <license>Apache-2.0</license>
  

  <!-- Author tags are optional, multiple are allowed, one per tag -->
  <!-- Authors do not have to be maintainers, but could be -->
  <!-- Example: -->
  <!-- <author email="rbhalekar@wpi.edu">Jane Doe</author> -->

  <member_of_group>rosidl_interface_packages</member_of_group>
  
  
   <!-- Build tool dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  


  <!-- Build dependencies -->
  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>rosidl_runtime_c</build_depend>
  <build_depend>rosidl_runtime_cpp</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rclpy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>rclpy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>geometry_msgs</build_depend>

  <depend>grasp_interfaces</depend>




  <!-- Runtime dependencies -->
  <!--exec_depend>rclpy</exec_depend-->
  <!--exec_depend>std_msgs</exec_depend>
  <exec_depend>numpy</exec_depend-->  <!-- Needed for numerical calculations -->
  <!--exec_depend>cv_bridge</exec_depend-->


  <!--depend>sensor_msgs</depend-->  <!-- Camera/LiDAR data needed at both times -->
  <!--depend>geometry_msgs</depend-->  <!-- Transformation messages used at both times -->
  
   <!-- Export dependencies -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>  
  <exec_depend>numpy</exec_depend>  <!-- Needed for numerical calculations -->
  <exec_depend>cv_bridge</exec_depend>



  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <!-- Other tools can request additional information be placed here -->
   <build_type>ament_cmake</build_type>
  </export>
</package>
